fn gcd(a: Int, b: Int) -> Int
  pure
  example "common factor"
    a: 12
    b: 18
    -> 6
  end
  example "coprime"
    a: 9
    b: 4
    -> 1
  end
  example "zero"
    a: 5
    b: 0
    -> 5
  end

  if b == 0
    return a
  end
  return gcd(a: b, b: a % b)
end fn gcd

fn lcm(a: Int, b: Int) -> Int
  pure
  example "shared factor"
    a: 4
    b: 6
    -> 12
  end
  example "coprime"
    a: 3
    b: 5
    -> 15
  end

  return a / gcd(a: a, b: b) * b
end fn lcm

fn problem005(n: Int) -> Int
  pure
  example "one through ten"
    n: 10
    -> 2520
  end

  var result: Int = 1
  for k in 1 until n + 1
    set result = lcm(a: result, b: k)
  end
  return result
end fn problem005
