import Cents, percent, half_up from "money"

fn exprs(xs: List<Int>, t: Result<List<Int>, Text,>) -> Int
  reads clock
  example "all"
    xs: [1, 2,]
    t: Ok([])
    clock: [1]
    -> 7
  end

  let a = 1 + 2 * 3 - -xs[0]
  let b = -t.items.first
  let c = comptime f(1) + 2
  let d = a <= b
  let e = clock.now()
  let s = "sum {a + 1} of {xs[0]} and {f("x")}"
  var i = 0
  for k in 0 until 3
    set i += k
  end
  for x in xs
    log("x is {x}")
  end
  let p = int_in(a, 1 through 100) or return 0
  let q = int_at_least(
    b,
    0
  ) or return
  let r = [true, false, nothing]
  let m = a + b / c * d % e
  let n = a / b / c % d
  return (a + b) * c
end fn exprs
