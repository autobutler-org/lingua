fn factorial(n: Int) -> Int
  pure
  example "zero"
    n: 0
    -> 1
  end
  example "five"
    n: 5
    -> 120
  end

  if n <= 1
    return 1
  end
  return n * factorial(n - 1)
end fn factorial

fn main() -> Nothing
  pure

  for i in 0 until 6
    log("{i}! = {factorial(i)}")
  end
  log("20! = {factorial(20)}")
  return nothing
end fn main
