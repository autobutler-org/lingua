fn main() -> Nothing
  pure

  let a: Int = 7
  let b: Int = 3
  log("{a + b}")
  log("{a - b}")
  log("{b - a}")
  log("{a * b}")
  log("{a + b * 2}")
  log("{(a + b) * 2}")
  log("{a - b - 1}")
  log("{2 * 3 + 4 * 5}")
  log("{-a + b}")
  log("{-(a + b)}")
  log("{a * -b}")
  return nothing
end fn main
