(program
  (main "main")
  (module "div_int_min" "div_int_min.lf"
    (functions
      (fn "main"
        (params)
        nothing
        pure
        (examples)
        (statements
          (let "bottom"
            (sub (int -9223372036854775807 : int) (int 1 : int) : int))
          (let "one" (int 1 : int))
          (let "minus_one" (int -1 : int))
          (expr
            (log
              (concat
                (text "before " : text)
                (div (local "bottom" : int) (local "one" : int) : int)
                :
                text)
              :
              nothing))
          (let "quotient"
            (div (local "bottom" : int) (local "minus_one" : int) : int))
          (expr
            (log
              (concat (text "after " : text) (local "quotient" : int) : text)
              :
              nothing))
          (return (nothing : nothing)))))))
