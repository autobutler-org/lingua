fn fizzbuzz(n: Int) -> Text
  pure
  example "fifteen"
    n: 15
    -> "FizzBuzz"
  end
  example "nine"
    n: 9
    -> "Fizz"
  end
  example "ten"
    n: 10
    -> "Buzz"
  end
  example "seven"
    n: 7
    -> "7"
  end

  if n % 15 == 0
    return "FizzBuzz"
  end
  if n % 3 == 0
    return "Fizz"
  end
  if n % 5 == 0
    return "Buzz"
  end
  return "{n}"
end fn fizzbuzz

fn main() -> Nothing
  pure

  for i in 1 until 16
    log(fizzbuzz(i))
  end
  return nothing
end fn main
