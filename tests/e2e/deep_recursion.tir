(program
  (main "main")
  (module "deep_recursion" "deep_recursion.lf"
    (functions
      (fn "depth"
        (params (param "n" int))
        int
        pure
        (examples
          (example "three levels" function
            (inputs (input "n" (int 3 : int)))
            (value (int 3 : int))))
        (statements
          (if
            (cmp eq (local "n" : int) (int 0 : int) : bool)
            (then (return (int 0 : int)))
            (else))
          (return
            (add
              (int 1 : int)
              (call "depth" (sub (local "n" : int) (int 1 : int) : int) : int)
              :
              int))))
      (fn "main"
        (params)
        nothing
        pure
        (examples)
        (statements
          (expr
            (log
              (concat
                (text "shallow " : text)
                (call "depth" (int 1000 : int) : int)
                :
                text)
              :
              nothing))
          (expr
            (log
              (concat
                (text "deep " : text)
                (call "depth" (int 100000000 : int) : int)
                :
                text)
              :
              nothing))
          (return (nothing : nothing)))))))
